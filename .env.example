# Copy this file to .env and fill in your own values.
# Never commit a real .env file or real Gmail credentials.

# Gmail SMTP (use a Gmail App Password, not your normal login password)
EMAIL_ADDRESS=yourgmail@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Optional: override Gmail defaults if you use another SMTP provider
CAMPUSSHIELD_SMTP_HOST=
CAMPUSSHIELD_SMTP_PORT=587
CAMPUSSHIELD_SMTP_USERNAME=
CAMPUSSHIELD_SMTP_PASSWORD=
CAMPUSSHIELD_SMTP_FROM=

# Flask
# Keep development settings for local XAMPP use. Set CAMPUSSHIELD_ENV=production
# in the hosting provider's environment, not in a committed file.
CAMPUSSHIELD_ENV=development
CAMPUSSHIELD_DEBUG=false
CAMPUSSHIELD_SECRET_KEY=change-this-in-production
CAMPUSSHIELD_DEV_MODE=true

# MariaDB / MySQL (local XAMPP defaults; use a dedicated non-root account in production)
CAMPUSSHIELD_DB_HOST=localhost
CAMPUSSHIELD_DB_PORT=3306
CAMPUSSHIELD_DB_NAME=campusshield
CAMPUSSHIELD_DB_USER=root
CAMPUSSHIELD_DB_PASSWORD=

# Optional extra exact frontend origins. The backend allows localhost development
# origins and HTTPS Render/Railway frontend origins by default. /api requests from
# the Railway-hosted frontend stay on the same service; Render keeps its existing
# separately hosted backend routing.
CAMPUSSHIELD_CORS_ORIGINS=

# Session options (production always requires HTTPS and Secure cookies)
CAMPUSSHIELD_COOKIE_SAMESITE=Lax
CAMPUSSHIELD_SESSION_LIFETIME_SECONDS=28800

# Twilio SMS (optional; leave blank to keep mobile OTP in development fallback)
CAMPUSSHIELD_SMS_PROVIDER=twilio
CAMPUSSHIELD_TWILIO_ACCOUNT_SID=
CAMPUSSHIELD_TWILIO_AUTH_TOKEN=
CAMPUSSHIELD_TWILIO_FROM_NUMBER=
